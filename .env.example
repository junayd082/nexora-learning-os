# NEXORA environment. Copy to .env.local and fill in.
# Supabase URL + publishable key are browser-safe (access is enforced by row-level security).
# If left unset, the app falls back to the defaults in src/lib/supabase/env.ts.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<key>

# Server-only. Never prefix with NEXT_PUBLIC_. Set in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
